{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrizmKit Retrospective Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outcome",
    "result",
    "reason",
    "change_paths",
    "documentation_paths",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "outcome": {
      "enum": ["RETRO_COMPLETE", "RETRO_BLOCKED"]
    },
    "result": {
      "enum": ["DOCS_UPDATED", "NO_DOC_CHANGE", null]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "change_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "allOf": [
          {
            "not": {
              "pattern": "\\\\"
            }
          },
          {
            "not": {
              "pattern": "^/"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|$)"
            }
          },
          {
            "not": {
              "pattern": "^\\.prizmkit(?:/|$)"
            }
          }
        ]
      }
    },
    "documentation_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.prizmkit/prizm-docs/.+\\.prizm$",
        "allOf": [
          {
            "not": {
              "pattern": "\\\\"
            }
          },
          {
            "not": {
              "pattern": "//"
            }
          },
          {
            "not": {
              "pattern": "(?:^|/)\\.\\.?(?:/|$)"
            }
          }
        ]
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "RETRO_COMPLETE"
        },
        "result": {
          "enum": ["DOCS_UPDATED", "NO_DOC_CHANGE"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "const": "DOCS_UPDATED"
              }
            }
          },
          "then": {
            "properties": {
              "documentation_paths": {
                "minItems": 1
              },
              "validation": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    {
      "properties": {
        "outcome": {
          "const": "RETRO_BLOCKED"
        },
        "result": {
          "type": "null"
        }
      }
    }
  ]
}
